<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Desktop application: MonoGame DesktopGL window, physical input, camera,
    rendering, UI. Reads simulation state from Arcade.Core, never decides rules.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>Arcade.Desktop</RootNamespace>
    <AssemblyName>Arcade.Desktop</AssemblyName>
    <RollForward>Major</RollForward>
    <PublishReadyToRun>false</PublishReadyToRun>
    <TieredPGO>true</TieredPGO>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.6.1" />
    <PackageReference Include="FontStashSharp.MonoGame" Version="1.6.2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Arcade.Core\Arcade.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Arcade.Tests" />
  </ItemGroup>
  <!--
    Game data is not compiled: in development the game reads content/ and mods/
    directly from the repository (see GameRootLocator). On publish, both folders
    are copied next to the executable.
  -->
  <ItemGroup>
    <None Include="..\..\content\**\*" LinkBase="content" CopyToOutputDirectory="Never" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\mods\**\*" LinkBase="mods" CopyToOutputDirectory="Never" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
